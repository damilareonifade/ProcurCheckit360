generator client {
  provider = "prisma-client"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String        @unique @map("user_id")
  balance      BigInt        @default(0)
  currency     String        @default("NGN") @db.VarChar(10)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]

  @@index([userId], name: "idx_wallets_user_id")
  @@map("wallets")
}

model Transaction {
  id                  String   @id @default(uuid())
  walletId            String   @map("wallet_id")
  reference           String   @unique @db.VarChar(100)
  type                String   @db.VarChar(10)
  amount              BigInt
  balanceAfter        BigInt   @map("balance_after")
  description         String?  @db.VarChar(200)
  counterpartyAccount String?  @map("counterparty_account") @db.VarChar(10)
  createdAt           DateTime @default(now()) @map("created_at")
  wallet              Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt], name: "idx_transactions_wallet_created")
  @@map("transactions")
}
